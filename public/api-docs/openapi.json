        "/ingest/snapshots": {
            "post": {
                "tags": [
                    "Ingest"
                ],
                "summary": "A Dot platform publishes its own signed daily metrics snapshot. No user token: send X-InfoDot-Timestamp (unix seconds, 5 minute tolerance) and X-InfoDot-Signature = sha256= + HMAC-SHA256(platform secret, \"{timestamp}.{raw body}\"). 201 stored, 200 replay (original id), 401 generic for every authentication failure, 404 unknown company, 422 contract broken, 429 rate limited. See docs/metrics-contract.md.",
                "operationId": "ingest-snapshots",
                "responses": {
                    "200": {
                        "description": "Success",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/SuccessResponse"
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthorized"
                    },
                    "422": {
                        "$ref": "#/components/responses/Unprocessable"
                    },
                    "429": {
                        "$ref": "#/components/responses/TooManyRequests"
                    }
                },
                "security": [],
                "parameters": [
                    {
                        "name": "X-InfoDot-Timestamp",
                        "in": "header",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "X-InfoDot-Signature",
                        "in": "header",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "platform": {
                                        "type": "string",
                                        "description": "The calling platform key, e.g. tasks."
                                    },
                                    "company_uuid": {
                                        "type": "string",
                                        "format": "uuid"
                                    },
                                    "taken_at": {
                                        "type": "string",
                                        "format": "date-time"
                                    },
                                    "period": {
                                        "type": "string",
                                        "enum": [
                                            "day"
                                        ]
                                    },
                                    "metrics": {
                                        "type": "object"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/v1/ingest/{platform}": {
            "post": {
                "tags": [
