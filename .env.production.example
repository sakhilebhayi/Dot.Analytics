# Production env vars for the single-container image built from Dockerfile
# (nginx + php-fpm + supervisor, see docker/). Inject these into the
# container's real environment at deploy time (hosting platform secrets,
# docker-compose prod override, etc.) -- this file is a reference, not
# something the container reads directly.

APP_NAME="Dot.Analytics"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=infodot
DB_USERNAME=
DB_PASSWORD=

SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=reverb
# Also required for REVERB_SCALING_ENABLED below, which lets multiple
# reverb:start processes share connection state via Redis pub/sub.
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379

# Generate a unique app id/key/secret per environment -- never reuse the
# same credentials across environments or across other Dot platforms:
#   php -r 'echo random_int(100000, 999999);'   # REVERB_APP_ID
#   php -r 'echo bin2hex(random_bytes(20));'     # REVERB_APP_KEY
#   php -r 'echo bin2hex(random_bytes(32));'     # REVERB_APP_SECRET
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=

# Public-facing values -- what browsers connect to (wss://your-domain.com),
# proxied by docker/nginx/default.conf's /app location block down to the
# reverb process inside the same container.
REVERB_HOST=your-domain.com
REVERB_PORT=443
REVERB_SCHEME=https

# Internal bind address/port for the reverb:start process itself
# (docker/supervisor/supervisord.conf's [program:reverb] already hardcodes
# --port=8080 to match this regardless of REVERB_PORT above; these two vars
# are what config/broadcasting.php's reverb connection uses for the PHP
# backend's own outbound publish path, which must hit the internal address,
# not round-trip through the public domain and nginx proxy for every
# broadcast). 127.0.0.1, not a docker-compose service hostname -- nginx,
# php-fpm, and reverb all run in the same container in production.
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080

# Requires QUEUE_CONNECTION=redis above. Off by default until more than one
# reverb:start process is actually running.
REVERB_SCALING_ENABLED=false

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
