APP_NAME="Dot.Analytics"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://analytics.infodot.app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=infodot
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@infodot.co.za"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http
# Real-time bell updates are on when BROADCAST_CONNECTION=reverb and REVERB_APP_KEY is set. Force on/off (e.g. false on
# a host that cannot run Reverb, where the bell polls instead): REALTIME_ENABLED=false

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# Production: set QUEUE_CONNECTION=redis and run: php artisan horizon
# Install Horizon: composer require laravel/horizon && php artisan horizon:install

HORIZON_PATH=horizon

# Signed InfoDot sign-in (the redeem flow). Set INFODOT_SERVICE_SECRET to the same value as
# ECOSYSTEM_SECRET_ANALYTICS in InfoDot's .env; leave it blank to accept only tokens found in this
# app's own database. Never commit a real secret.
INFODOT_REDEEM_URL=https://infodot.co.za/api/ecosystem/redeem
INFODOT_PLATFORM_KEY=analytics
INFODOT_SERVICE_SECRET=
INFODOT_REDEEM_TIMEOUT=5
INFODOT_PROVISION_USERS=true

# Server-to-server snapshot ingest (POST /api/ingest/snapshots, no user token). Each Dot platform signs
# "{timestamp}.{raw body}" with HMAC-SHA256 using its OWN secret; a blank value means that platform cannot call.
# Set the same value in the publishing platform's .env. Generate with: php -r 'echo bin2hex(random_bytes(32));'
# Never commit a real secret.
ANALYTICS_INGEST_SECRET_TASKS=
ANALYTICS_INGEST_SECRET_HR=
ANALYTICS_INGEST_SECRET_AUCTION=
ANALYTICS_INGEST_SECRET_EHAIL=
ANALYTICS_INGEST_SECRET_FARMS=
ANALYTICS_INGEST_SECRET_BILLING=
ANALYTICS_INGEST_SECRET_EMALL=
ANALYTICS_INGEST_SECRET_TUTOR=
ANALYTICS_INGEST_SECRET_PULSE=
ANALYTICS_INGEST_SECRET_NOTIFY=
ANALYTICS_INGEST_SECRET_DESIGN=
ANALYTICS_INGEST_RATE_LIMIT=120
